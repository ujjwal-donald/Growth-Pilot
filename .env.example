# App
NEXT_PUBLIC_APP_NAME="UPDON AI Marketing"
NEXT_PUBLIC_APP_URL="https://your-dev-host.example"
NODE_ENV="development"
# development | test | production — match the GitHub Environment name
APP_ENV="development"

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Neon PostgreSQL
# DATABASE_URL = pooled connection (runtime / seed). Host usually contains "-pooler".
# DIRECT_URL   = direct connection (prisma migrate / db push). Host has no "-pooler".
# Never commit real connection strings. Set these in GitHub Environment secrets.
DATABASE_URL=""
DIRECT_URL=""

# First platform admin (optional)
ADMIN_EMAIL="you@company.com"

# AI providers — never expose these to the browser
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Future providers
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""

# Token encryption for social credentials (32+ character secret)
TOKEN_ENCRYPTION_KEY=""

# Storage
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Billing (do not connect until credentials are supplied)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email
EMAIL_FROM="UPDON <noreply@updon.ai>"
RESEND_API_KEY=""

# Social OAuth (optional — demo connect works in development without these)
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ID=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_AUTHOR_URN=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_BUSINESS_LOCATION_NAME=""

# Scheduler
CRON_SECRET=""
# true = run a 60s in-process worker (default on in development)
ENABLE_IN_PROCESS_SCHEDULER=""
