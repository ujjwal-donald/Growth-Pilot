# App
NEXT_PUBLIC_APP_NAME="UPDON AI Marketing"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave empty to hide Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# PostgreSQL
DATABASE_URL="postgresql://updon:updon_dev_password@localhost:5432/updon_ai_marketing?schema=public"

# First platform admin (optional)
ADMIN_EMAIL="you@company.com"

# AI providers — never expose these to the browser
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Future providers
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""

# Token encryption for social credentials (32+ character secret)
TOKEN_ENCRYPTION_KEY=""

# Storage
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Billing (do not connect until credentials are supplied)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email (Phase 2)
EMAIL_FROM="UPDON <noreply@updon.ai>"
RESEND_API_KEY=""
